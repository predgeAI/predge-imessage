# Copy to .env and fill in. .env is gitignored.

# --- Linq (iMessage transport) — sandbox token from linqapp.com/imessage-api ---
LINQ_API_TOKEN=
LINQ_API_BASE_URL=https://api.linqapp.com/api/partner/v3

# --- OpenAI — the agent's brain (plan + reply) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Predge data (bought per query over x402) ---
# Default = live prod on Base mainnet (~$0.005/query real). For a 0-money demo point at
# a local Base Sepolia Predge instead:
# PREDGE_BASE=http://localhost:4021
# Float wallet: defaults to ~/.predge-x402/buyer.json; or set FLOAT_PRIVATE_KEY=0x...

PORT=8080
